{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx \"$CLAUDE_PROJECT_DIR/scripts/claudeLintHook.ts\"",
            "timeout": 60,
            "statusMessage": "Checking project conventions..."
          }
        ]
      }
    ]
  }
}
