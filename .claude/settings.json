{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx \"$CLAUDE_PROJECT_DIR/scripts/claudeLintHook.ts\"",
            "timeout": 60,
            "statusMessage": "Checking project conventions..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "PowerShell(pnpm install --frozen-lockfile)",
      "Bash(pnpm lint)",
      "PowerShell(pnpm lint)",
      "Bash(pnpm format)",
      "PowerShell(pnpm format)",
      "Bash(pnpm typecheck)",
      "PowerShell(pnpm typecheck)",
      "Bash(pnpm test)",
      "PowerShell(pnpm test)",
      "Bash(pnpm test:unit)",
      "PowerShell(pnpm test:unit)",
      "Bash(pnpm test:integration)",
      "PowerShell(pnpm test:integration)",
      "Bash(pnpm test:all)",
      "PowerShell(pnpm test:all)",
      "Bash(pnpm test:system)",
      "PowerShell(pnpm test:system)",
      "Bash(pnpm test:firmware)",
      "PowerShell(pnpm test:firmware)",
      "Bash(pnpm check:codegen)",
      "PowerShell(pnpm check:codegen)",
      "Bash(pnpm generate-configs)",
      "PowerShell(pnpm generate-configs)",
      "Bash(pnpm spec:render *)",
      "PowerShell(pnpm spec:render *)",
      "Bash(pnpm spec:render)",
      "PowerShell(pnpm spec:render)",
      "Bash(pnpm spec:check-sources *)",
      "PowerShell(pnpm spec:check-sources *)",
      "Bash(pnpm spec:check-sources)",
      "PowerShell(pnpm spec:check-sources)",
      "Bash(pnpm vitest run *)",
      "PowerShell(pnpm vitest run *)",
      "Bash(npx vitest run *)",
      "PowerShell(npx vitest run *)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(git status)",
      "PowerShell(git status)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git diff)",
      "PowerShell(git diff)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git log)",
      "PowerShell(git log)",
      "Bash(git show *)",
      "PowerShell(git show *)",
      "Bash(git rev-parse *)",
      "PowerShell(git rev-parse *)",
      "Bash(git branch *)",
      "PowerShell(git branch *)",
      "Bash(git remote get-url *)",
      "PowerShell(git remote get-url *)",
      "Bash(git fetch *)",
      "PowerShell(git fetch *)",
      "Bash(git fetch)",
      "PowerShell(git fetch)",
      "Bash(git cat-file *)",
      "PowerShell(git cat-file *)",
      "Bash(git merge-base *)",
      "PowerShell(git merge-base *)",
      "Bash(git config user.name)",
      "PowerShell(git config user.name)",
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(git checkout -b *)",
      "PowerShell(git checkout -b *)",
      "Bash(git switch -c *)",
      "PowerShell(git switch -c *)",
      "Bash(docker info)",
      "PowerShell(docker info)",
      "Bash(docker ps *)",
      "PowerShell(docker ps *)",
      "Bash(docker ps)",
      "PowerShell(docker ps)",
      "Bash(pio --version)",
      "PowerShell(pio --version)",
      "Bash(gh auth status)",
      "PowerShell(gh auth status)",
      "Bash(gh pr checks *)",
      "PowerShell(gh pr checks *)",
      "Bash(gh pr view *)",
      "PowerShell(gh pr view *)",
      "Bash(gh run view *)",
      "PowerShell(gh run view *)",
      "Bash(gh run list *)",
      "PowerShell(gh run list *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git push)",
      "PowerShell(git push)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)",
      "Bash(gh pr comment *)",
      "PowerShell(gh pr comment *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(gh pr edit *)",
      "PowerShell(gh pr edit *)",
      "Bash(gh pr review *)",
      "PowerShell(gh pr review *)",
      "Bash(gh issue *)",
      "PowerShell(gh issue *)",
      "Bash(gh api *)",
      "PowerShell(gh api *)",
      "Bash(pnpm test:firmware:update)",
      "PowerShell(pnpm test:firmware:update)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push * --force*)",
      "PowerShell(git push * --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push * -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git clean *)",
      "PowerShell(git clean *)",
      "Bash(git clean)",
      "PowerShell(git clean)",
      "Read(./.env)",
      "Read(./.env.shared)",
      "Read(**/.env)",
      "Read(**/.env.shared)"
    ]
  }
}
