{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    "outDir": "./dist",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,
    "declaration": true
  },
  "include": [
    "*.ts",
    "src/**/*",
    "scripts/**/*",
    "helpers/**/*",
    "generated/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
