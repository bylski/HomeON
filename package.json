{
  "name": "homeon",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate-configs": "npx tsx ./scripts/generateConfigFiles/index.ts",
    "upload": "pio run --project-dir firmware -t upload -e",
    "lint": "eslint . && prettier --check . && tsx scripts/lintCpp.ts && pnpm typecheck",
    "format": "eslint . --fix && prettier --write . && tsx scripts/lintCpp.ts --fix",
    "typecheck": "tsc --noEmit -p . && pnpm -r typecheck",
    "check:codegen": "tsx scripts/checkCodegen.ts",
    "prepare": "husky",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@home-on/eslint-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.6"
  }
}
